# Choose active provider: anthropic | openai | openrouter | ollama
ECLIVEN_PROVIDER=anthropic

# Optional model override (otherwise provider default is used)
# ECLIVEN_MODEL=claude-sonnet-4-20250514

# Provider API keys (set the one matching your chosen provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional custom base URLs
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_BASE_URL=http://localhost:11434
# ANTHROPIC_BASE_URL=https://api.anthropic.com
